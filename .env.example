# Operator private key (for submitting on-chain transactions)
PRIVATE_KEY=0x...

BASE_SEPOLIA_RPC=https://sepolia.base.org

USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

ESCROW_VAULT_ADDRESS=0x...

PORT=3000

# Facilitator fee (optional, default: 0 = no fee)
FEE_BPS=100              # Fee in basis points (100 = 1%, max 1000 = 10%)
FEE_FLAT_USDC=50000      # Flat fee in USDC smallest unit (50000 = $0.05, covers gas costs)
FEE_RECIPIENT=           # Address to receive facilitator fees (required if FEE_BPS > 0 or FEE_FLAT_USDC > 0)

# Deployment config (optional — all default to deployer address if unset)
ARBITER_ADDRESS=         # Initial dispute arbiter for EscrowVault (default: deployer)
FACILITATOR_ADDRESS=     # Facilitator server address for SessionEscrow (default: deployer)
