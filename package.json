{
  "name": "xenga",
  "version": "0.1.0",
  "private": true,
  "description": "An on-chain escrow and reputation system for secure, verifiable payments — for both humans and autonomous agents",
  "workspaces": ["packages/*", "web"],
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "start": "bun src/server/index.ts",
    "build:types": "cd packages/types && bun run build",
    "build:client": "cd packages/client && bun run build",
    "build:server": "cd packages/server && bun run build",
    "build:packages": "bun run build:types && bun run build:client && bun run build:server",
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test",
    "sync-abi": "bun scripts/sync-abi.ts",
    "deploy": "bun scripts/deploy.ts",
    "deploy:local": "bun scripts/deploy.ts --local"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "jose": "^6.1.3",
    "siwe": "^3.0.0",
    "uuid": "^10.0.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@types/bun": "^1.3.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  }
}
