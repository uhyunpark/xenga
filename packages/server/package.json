{
  "name": "@xenga/server",
  "version": "0.1.0",
  "description": "Server SDK for xenga escrow payments — middleware, service types, facilitator dispatch",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./express": {
      "import": "./dist/express.js",
      "types": "./dist/express.d.ts"
    },
    "./nextjs": {
      "import": "./dist/nextjs.js",
      "types": "./dist/nextjs.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@xenga/types": "workspace:*"
  },
  "peerDependencies": {
    "viem": "^2.21.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
