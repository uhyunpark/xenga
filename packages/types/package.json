{
  "name": "@x402/types",
  "version": "0.1.0",
  "description": "Shared types, constants, and ABIs for x402 escrow payment protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
